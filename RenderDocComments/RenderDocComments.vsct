<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidRenderDocPackage">
    <Groups>
      <!-- Group on the Standard toolbar -->
      <Group guid="guidRenderDocCommandSet" id="MyToolbarGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_TOOL_STANDARD"/>
      </Group>
      
      <!-- Group on the Editor Context Menu -->
      <Group guid="guidRenderDocCommandSet" id="MyContextMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidRenderDocCommandSet" id="cmdidRenderDocOptions"
              priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS"/>
        <Strings>
          <ButtonText>Render Doc Options</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidRenderDocCommandSet" id="cmdidToggleRenderPerFile"
              priority="0x0100" type="Button">
        <Parent guid="guidRenderDocCommandSet" id="MyToolbarGroup"/>
        <CommandFlag>TextOnly</CommandFlag>
        <Strings>
          <ButtonText>Render Doc Comments for this file</ButtonText>
          <ToolTipText>Toggle Doc Rendering for this file</ToolTipText>
        </Strings>
      </Button>
    </Buttons>
    </Commands>

    <CommandPlacements>
    <CommandPlacement guid="guidRenderDocCommandSet" id="cmdidToggleRenderPerFile" priority="0x0100">
      <Parent guid="guidRenderDocCommandSet" id="MyContextMenuGroup"/>
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <!-- This GUID must match PackageGuidString in RenderDocCommentsPackage.cs -->
    <GuidSymbol name="guidRenderDocPackage"
                value="{6381b007-68f8-48f1-9db5-f450f3a1a6b0}"/>

    <!-- This GUID must match CommandSet in RenderDocOptionsCommand.cs -->
    <GuidSymbol name="guidRenderDocCommandSet"
                value="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}">
      <IDSymbol name="cmdidRenderDocOptions" value="0x0100"/>
      <IDSymbol name="cmdidToggleRenderPerFile" value="0x0101"/>
      <IDSymbol name="MyToolbarGroup" value="0x1020"/>
      <IDSymbol name="MyContextMenuGroup" value="0x1030"/>
    </GuidSymbol>
  </Symbols>

</CommandTable>