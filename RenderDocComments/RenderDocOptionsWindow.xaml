<Window
	x:Class="RenderDocComments.RenderDocOptionsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="RenderDocComments Options"
	Width="620"
	Height="720"
	Background="#17171A"
	FontFamily="Segoe UI"
	FontSize="13"
	Foreground="#E4E4E7"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen">

	<Window.Resources>

		<!--  ================= Palette =================  -->
		<SolidColorBrush x:Key="SurfaceBrush" Color="#212124" />
		<SolidColorBrush x:Key="SurfaceHiBrush" Color="#2A2A2E" />
		<SolidColorBrush x:Key="BorderBrush2" Color="#33333A" />
		<SolidColorBrush x:Key="TextMutedBrush" Color="#93939C" />
		<SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
		<SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#1F3B82F6" />
		<SolidColorBrush x:Key="AccentPurpleBrush" Color="#B15CF0" />
		<SolidColorBrush x:Key="DangerBrush" Color="#F48771" />

		<!--  ================= Shared button template =================  -->
		<ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
			<Border
				x:Name="border"
				Padding="{TemplateBinding Padding}"
				Background="{TemplateBinding Background}"
				BorderBrush="{TemplateBinding BorderBrush}"
				BorderThickness="{TemplateBinding BorderThickness}"
				CornerRadius="6"
				SnapsToDevicePixels="True">
				<ContentPresenter
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					RecognizesAccessKey="True" />
			</Border>
			<ControlTemplate.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter TargetName="border" Property="Opacity" Value="0.85" />
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter TargetName="border" Property="Opacity" Value="0.7" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter TargetName="border" Property="Opacity" Value="0.4" />
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

		<!--  ================= Text styles =================  -->
		<Style x:Key="SectionHeader" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>
		<Style x:Key="OptionLabel" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="Margin" Value="0,0,8,0" />
		</Style>
		<Style x:Key="HintText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>
		<Style x:Key="Divider" TargetType="Border">
			<Setter Property="Height" Value="1" />
			<Setter Property="Background" Value="{StaticResource BorderBrush2}" />
			<Setter Property="Margin" Value="0,14,0,14" />
		</Style>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="16" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>

		<!--  ================= CheckBox =================  -->
		<Style TargetType="CheckBox">
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,4,0,4" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal">
							<Border
								x:Name="box"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								Background="{StaticResource SurfaceHiBrush}"
								BorderBrush="{StaticResource BorderBrush2}"
								BorderThickness="1"
								CornerRadius="4">
								<Path
									x:Name="check"
									Data="M 2.5 6 L 6 9.5 L 12 2.5"
									Stroke="White"
									StrokeEndLineCap="Round"
									StrokeLineJoin="Round"
									StrokeStartLineCap="Round"
									StrokeThickness="1.6"
									Visibility="Collapsed" />
							</Border>
							<ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="box" Property="Background" Value="{StaticResource AccentBlueBrush}" />
								<Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
								<Setter TargetName="check" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= RadioButton =================  -->
		<Style TargetType="RadioButton">
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<StackPanel Orientation="Horizontal">
							<Border
								x:Name="circle"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								Background="{StaticResource SurfaceHiBrush}"
								BorderBrush="{StaticResource BorderBrush2}"
								BorderThickness="1"
								CornerRadius="8">
								<Ellipse
									x:Name="dot"
									Width="7"
									Height="7"
									Fill="White"
									Visibility="Collapsed" />
							</Border>
							<ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="circle" Property="Background" Value="{StaticResource AccentBlueBrush}" />
								<Setter TargetName="circle" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
								<Setter TargetName="dot" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="circle" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= TextBox =================  -->
		<Style TargetType="TextBox">
			<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="Margin" Value="0,2,0,2" />
			<Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6">
							<ScrollViewer
								x:Name="PART_ContentHost"
								Margin="{TemplateBinding Padding}"
								VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= ComboBox =================  -->
		<Style TargetType="ComboBox">
			<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="Margin" Value="0,2,0,2" />
			<Setter Property="ItemContainerStyle">
				<Setter.Value>
					<Style TargetType="ComboBoxItem">
						<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
						<Setter Property="Foreground" Value="#E4E4E7" />
						<Setter Property="Padding" Value="8,5" />
						<Style.Triggers>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter Property="Background" Value="{StaticResource AccentBlueSoftBrush}" />
								<Setter Property="Foreground" Value="#FFFFFF" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
								<Setter Property="Foreground" Value="#FFFFFF" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<ToggleButton
								x:Name="ToggleButton"
								ClickMode="Press"
								Focusable="False"
								IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border
											Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
											BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
											BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
											CornerRadius="6">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="24" />
												</Grid.ColumnDefinitions>
												<Path
													Grid.Column="1"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Data="M 0 0 L 8 0 L 4 5 Z"
													Fill="#93939C" />
											</Grid>
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<ContentPresenter
								x:Name="ContentSite"
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Content="{TemplateBinding SelectionBoxItem}"
								ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
								ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
								IsHitTestVisible="False"
								TextElement.Foreground="{TemplateBinding Foreground}" />

							<Popup
								x:Name="Popup"
								AllowsTransparency="True"
								Focusable="False"
								IsOpen="{TemplateBinding IsDropDownOpen}"
								Placement="Bottom"
								PopupAnimation="Slide">
								<Border
									MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
									MaxHeight="{TemplateBinding MaxDropDownHeight}"
									Background="{StaticResource SurfaceHiBrush}"
									BorderBrush="{StaticResource BorderBrush2}"
									BorderThickness="1"
									CornerRadius="6"
									SnapsToDevicePixels="True">
									<ScrollViewer SnapsToDevicePixels="True">
										<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= Buttons =================  -->
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="Margin" Value="4,0" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
		</Style>
		<Style x:Key="SecondaryButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="Margin" Value="4,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
		</Style>
		<Style x:Key="PremiumBadge" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource AccentPurpleBrush}" />
			<Setter Property="CornerRadius" Value="9" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="Margin" Value="8,0,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style x:Key="SwatchButton" TargetType="Button">
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="22" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
		</Style>

	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ── Header (always visible)  -->
		<Border
			Grid.Row="0"
			BorderBrush="{StaticResource BorderBrush2}"
			BorderThickness="0,0,0,1">
			<StackPanel
				Margin="22,16,22,16"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<TextBlock
					FontSize="17"
					FontWeight="Bold"
					Foreground="{StaticResource AccentPurpleBrush}"
					Text="Render Doc Comments" />
				<TextBlock
					Margin="10,3,0,0"
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{StaticResource TextMutedBrush}"
					Text="Visual Studio Extension" />
			</StackPanel>
		</Border>

		<!--  ── Body (scrolls)  -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
			<StackPanel Margin="20,16,20,16">

				<!--  ══ Licence  -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<TextBlock Style="{StaticResource SectionHeader}" Text="LICENCE" />

						<StackPanel
							Margin="0,0,0,4"
							VerticalAlignment="Center"
							Orientation="Horizontal">
							<Border
								x:Name="PremiumStatusBadge"
								Margin="0,0,10,0"
								Padding="9,4"
								VerticalAlignment="Center"
								CornerRadius="6">
								<TextBlock
									x:Name="PremiumStatusText"
									FontSize="12"
									FontWeight="SemiBold" />
							</Border>

							<!--  Free: open the purchase/activation window  -->
							<Button
								x:Name="GetPremiumButton"
								Click="OnGetPremiumClicked"
								Content="Get Premium…"
								Style="{StaticResource PrimaryButton}"
								Visibility="Collapsed" />

							<!--  Premium: deactivate this machine  -->
							<Button
								x:Name="DeactivateButton"
								Click="OnDeactivateClicked"
								Content="Deactivate this machine"
								Style="{StaticResource SecondaryButton}"
								Visibility="Collapsed" />
						</StackPanel>

						<TextBlock
							x:Name="LicenseMessageText"
							Margin="0,4,0,0"
							FontSize="11"
							Foreground="{StaticResource DangerBrush}"
							TextWrapping="Wrap"
							Visibility="Collapsed" />
					</StackPanel>
				</Border>

				<!--  ══ FREE: Global render toggle  -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<TextBlock Style="{StaticResource SectionHeader}" Text="GENERAL (FREE)" />

						<CheckBox
							x:Name="RenderEnabledCheck"
							Checked="OnSettingChanged"
							Content="Enable doc comment rendering"
							Unchecked="OnSettingChanged" />

						<CheckBox
							x:Name="TagBadgesCheck"
							Checked="OnTagBadgesChanged"
							Content="Enable comment tag highlighting"
							Unchecked="OnTagBadgesChanged" />

						<StackPanel Margin="24,8,0,2" Orientation="Horizontal">
							<TextBlock
								VerticalAlignment="Center"
								Style="{StaticResource OptionLabel}"
								Text="Comment tag style:" />
							<RadioButton
								x:Name="TagPillsRadio"
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								Checked="OnTagStyleChanged"
								Content="Pills"
								GroupName="TagStyle" />
							<RadioButton
								x:Name="TagCardsRadio"
								Margin="18,0,0,0"
								VerticalAlignment="Center"
								Checked="OnTagStyleChanged"
								Content="Card"
								GroupName="TagStyle" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!--  ══ Premium section  -->
				<Border Style="{StaticResource Card}">
					<StackPanel>

						<StackPanel Margin="0,0,0,4" Orientation="Horizontal">
							<TextBlock
								Margin="0"
								Style="{StaticResource SectionHeader}"
								Text="PREMIUM FEATURES" />
							<Border
								Margin="8,0,0,0"
								RenderTransformOrigin="0.496,0.752"
								Style="{StaticResource PremiumBadge}">
								<TextBlock
									FontSize="9"
									FontWeight="Bold"
									Foreground="White"
									Text="PREMIUM" />
							</Border>
						</StackPanel>

						<TextBlock Style="{StaticResource HintText}" Text="Requires a Premium licence. Options are shown but disabled without one." />

						<StackPanel x:Name="PremiumOptionsPanel">

							<!--  Glyph toggle  -->
							<TextBlock Style="{StaticResource SectionHeader}" Text="MARGIN GLYPH TOGGLE" />
							<StackPanel Margin="0,0,0,4">
								<RadioButton
									x:Name="CaretModeRadio"
									Margin="0,0,0,8"
									Checked="OnToggleModeChanged"
									Content="Caret-based (free) — caret in block shows raw XML" />
								<RadioButton
									x:Name="GlyphModeRadio"
									Checked="OnToggleModeChanged"
									Content="Margin glyph button (Premium) — click to toggle per comment" />
							</StackPanel>

							<Border Style="{StaticResource Divider}" />

							<!--  Auto theme refresh  -->
							<TextBlock Style="{StaticResource SectionHeader}" Text="THEME AUTO-REFRESH" />
							<CheckBox
								x:Name="AutoRefreshCheck"
								Checked="OnSettingChanged"
								Content="Auto-refresh colours when VS colour theme changes"
								Unchecked="OnSettingChanged" />

							<Border Style="{StaticResource Divider}" />

							<!--  Fixed width  -->
							<TextBlock Style="{StaticResource SectionHeader}" Text="COMMENT WIDTH" />
							<CheckBox
								x:Name="UseFixedWidthCheck"
								Checked="OnFixedWidthChanged"
								Content="Use fixed width"
								Unchecked="OnFixedWidthChanged" />
							<StackPanel Margin="24,8,0,2" Orientation="Horizontal">
								<TextBlock Style="{StaticResource OptionLabel}" Text="Fixed width (px):" />
								<TextBox
									x:Name="FixedWidthText"
									Width="70"
									TextAlignment="Left"
									TextChanged="OnFixedWidthTextChanged" />
							</StackPanel>

							<Border Style="{StaticResource Divider}" />

							<!--  Font  -->
							<TextBlock Style="{StaticResource SectionHeader}" Text="RENDERED FONT" />
							<StackPanel Orientation="Horizontal">
								<TextBlock Style="{StaticResource OptionLabel}" Text="Font family:" />
								<ComboBox
									x:Name="FontFamilyCombo"
									Width="200"
									SelectionChanged="OnFontFamilyChanged" />
								<TextBlock
									x:Name="FontPreviewText"
									Margin="12,0,0,0"
									VerticalAlignment="Center"
									Foreground="{StaticResource AccentPurpleBrush}"
									Text="AaBbCc 123" />
							</StackPanel>

							<Border Style="{StaticResource Divider}" />

							<!--  Border sides  -->
							<TextBlock Style="{StaticResource SectionHeader}" Text="ACCENT BAR SIDES" />
							<StackPanel Orientation="Horizontal">
								<CheckBox
									x:Name="BorderLeftCheck"
									Margin="0,0,18,0"
									Checked="OnSettingChanged"
									Content="Left"
									Unchecked="OnSettingChanged" />
								<CheckBox
									x:Name="BorderTopCheck"
									Margin="0,0,18,0"
									Checked="OnSettingChanged"
									Content="Top"
									Unchecked="OnSettingChanged" />
								<CheckBox
									x:Name="BorderRightCheck"
									Margin="0,0,18,0"
									Checked="OnSettingChanged"
									Content="Right"
									Unchecked="OnSettingChanged" />
								<CheckBox
									x:Name="BorderBottomCheck"
									Checked="OnSettingChanged"
									Content="Bottom"
									Unchecked="OnSettingChanged" />
							</StackPanel>

							<Border Style="{StaticResource Divider}" />

							<!--  Colours  -->
							<TextBlock Style="{StaticResource SectionHeader}" Text="RENDERED COLOURS" />
							<TextBlock Style="{StaticResource HintText}" Text="Click a swatch to open the colour picker." />

							<Grid Margin="0,0,0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<StackPanel
									Grid.Row="0"
									Grid.Column="0"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchCodeFg"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="CodeFg" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Inline code / quoted" />
								</StackPanel>
								<StackPanel
									Grid.Row="0"
									Grid.Column="1"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchSummaryFg"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="SummaryFg" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Summary text" />
								</StackPanel>
								<StackPanel
									Grid.Row="1"
									Grid.Column="0"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchParamName"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="ParamName" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Parameter names" />
								</StackPanel>
								<StackPanel
									Grid.Row="1"
									Grid.Column="1"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchLink"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="Link" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Links / crefs" />
								</StackPanel>
								<StackPanel
									Grid.Row="2"
									Grid.Column="0"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchSectionLabel"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="SectionLabel" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Section headings" />
								</StackPanel>
							</Grid>

							<!--  Gradient  -->
							<TextBlock
								Margin="0,4,0,6"
								FontSize="11"
								FontWeight="SemiBold"
								Foreground="#E4E4E7"
								Text="Gradient bar colours" />

							<StackPanel Margin="0,0,0,8" Orientation="Horizontal">
								<TextBlock Style="{StaticResource OptionLabel}" Text="Presets:" />
								<Button
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Purple"
									Style="{StaticResource SecondaryButton}"
									Tag="Purple" />
								<Button
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Ocean"
									Style="{StaticResource SecondaryButton}"
									Tag="Ocean" />
								<Button
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Sunset"
									Style="{StaticResource SecondaryButton}"
									Tag="Sunset" />
								<Button
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Forest"
									Style="{StaticResource SecondaryButton}"
									Tag="Forest" />
								<Button
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Rose Gold"
									Style="{StaticResource SecondaryButton}"
									Tag="RoseGold" />
							</StackPanel>

							<StackPanel Margin="0,0,0,4" Orientation="Horizontal">
								<Button
									x:Name="SwatchGrad0"
									Width="32"
									Click="OnSwatchClicked"
									Style="{StaticResource SwatchButton}"
									Tag="Grad0" />
								<TextBlock
									Margin="4,0,14,0"
									VerticalAlignment="Center"
									FontSize="11"
									Foreground="{StaticResource TextMutedBrush}"
									Text="Stop 1" />
								<Button
									x:Name="SwatchGrad1"
									Width="32"
									Click="OnSwatchClicked"
									Style="{StaticResource SwatchButton}"
									Tag="Grad1" />
								<TextBlock
									Margin="4,0,14,0"
									VerticalAlignment="Center"
									FontSize="11"
									Foreground="{StaticResource TextMutedBrush}"
									Text="Stop 2" />
								<Button
									x:Name="SwatchGrad2"
									Width="32"
									Click="OnSwatchClicked"
									Style="{StaticResource SwatchButton}"
									Tag="Grad2" />
								<TextBlock
									Margin="4,0,14,0"
									VerticalAlignment="Center"
									FontSize="11"
									Foreground="{StaticResource TextMutedBrush}"
									Text="Stop 3" />
								<Border
									x:Name="GradientPreviewBar"
									Width="220"
									Height="22"
									Margin="10,0,0,0"
									CornerRadius="6" />
							</StackPanel>

							<Border Style="{StaticResource Divider}" />

							<!--  Comment Tag Badges  -->
							<StackPanel x:Name="TagBadgeSectionPanel">
								<TextBlock Style="{StaticResource SectionHeader}" Text="COMMENT TAG BADGES" />
								<TextBlock Style="{StaticResource HintText}" Text="Per-tag visibility and colours for plain comments (TODO, FIXME, …). WARNING is an alias of WARN." />
								<StackPanel x:Name="TagBadgeListPanel" Margin="0,0,0,8" />
								<Button
									Margin="0"
									Padding="9,4"
									HorizontalAlignment="Left"
									Click="OnResetBadgeColorsClicked"
									Content="Reset colours to defaults"
									Style="{StaticResource SecondaryButton}" />
							</StackPanel>

						</StackPanel>
						<!--  /PremiumOptionsPanel  -->

					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!--  ── Footer (always visible)  -->
		<Border
			Grid.Row="2"
			Padding="20,12"
			Background="#1D1D20"
			BorderBrush="{StaticResource BorderBrush2}"
			BorderThickness="0,1,0,0">
			<Grid>
				<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
					<Button
						Click="RatingButton_Click"
						Content="Please, leave a review"
						Foreground="{StaticResource AccentPurpleBrush}"
						Style="{StaticResource SecondaryButton}" />
				</StackPanel>
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						Click="OnResetClicked"
						Content="Reset to Defaults"
						Style="{StaticResource SecondaryButton}" />
					<Button
						Click="OnSaveClicked"
						Content="Save"
						Style="{StaticResource PrimaryButton}" />
					<Button
						Click="OnCloseClicked"
						Content="Close"
						Style="{StaticResource SecondaryButton}" />
				</StackPanel>
			</Grid>
		</Border>

	</Grid>
</Window>
