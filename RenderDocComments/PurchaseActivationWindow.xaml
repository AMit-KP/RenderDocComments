<Window
	x:Class="RenderDocComments.PurchaseActivationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Get Premium — Render Doc Comments"
	Width="520"
	Background="#17171A"
	FontFamily="Segoe UI"
	FontSize="13"
	Foreground="#E4E4E7"
	ResizeMode="NoResize"
	SizeToContent="Height"
	WindowStartupLocation="CenterOwner">

	<Window.Resources>

		<!--  ================= Palette (matches Options / Tool Window) =================  -->
		<SolidColorBrush x:Key="SurfaceBrush" Color="#212124" />
		<SolidColorBrush x:Key="SurfaceHiBrush" Color="#2A2A2E" />
		<SolidColorBrush x:Key="BorderBrush2" Color="#33333A" />
		<SolidColorBrush x:Key="TextMutedBrush" Color="#93939C" />
		<SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
		<SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#1F3B82F6" />
		<SolidColorBrush x:Key="AccentPurpleBrush" Color="#B15CF0" />
		<SolidColorBrush x:Key="AccentPurpleSoftBrush" Color="#22B15CF0" />
		<SolidColorBrush x:Key="WarningBrush" Color="#F5A623" />
		<SolidColorBrush x:Key="WarningSoftBrush" Color="#1FF5A623" />

		<!--  ================= Shared button template =================  -->
		<ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
			<Border
				x:Name="border"
				Padding="{TemplateBinding Padding}"
				Background="{TemplateBinding Background}"
				BorderBrush="{TemplateBinding BorderBrush}"
				BorderThickness="{TemplateBinding BorderThickness}"
				CornerRadius="7"
				SnapsToDevicePixels="True">
				<ContentPresenter
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					RecognizesAccessKey="True" />
			</Border>
			<ControlTemplate.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter TargetName="border" Property="Opacity" Value="0.85" />
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter TargetName="border" Property="Opacity" Value="0.7" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter TargetName="border" Property="Opacity" Value="0.4" />
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

		<!--  ================= Ghost icon-button template (for the copy button) =================  -->
		<ControlTemplate x:Key="GhostIconButtonTemplate" TargetType="Button">
			<Border
				x:Name="border"
				Padding="{TemplateBinding Padding}"
				Background="Transparent"
				CornerRadius="5">
				<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
			</Border>
			<ControlTemplate.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceHiBrush}" />
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

		<!--  ================= Text / layout styles =================  -->
		<Style x:Key="SectionHeader" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>
		<Style x:Key="HintText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="16" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>
		<Style x:Key="Divider" TargetType="Border">
			<Setter Property="Height" Value="1" />
			<Setter Property="Background" Value="{StaticResource BorderBrush2}" />
			<Setter Property="Margin" Value="0,4,0,12" />
		</Style>

		<!--  ================= TextBox =================  -->
		<Style TargetType="TextBox">
			<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="10,7" />
			<Setter Property="Margin" Value="0,2,0,2" />
			<Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="7">
							<ScrollViewer
								x:Name="PART_ContentHost"
								Margin="{TemplateBinding Padding}"
								VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= Buttons =================  -->
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="Margin" Value="4,0" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
					<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="SecondaryButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="Margin" Value="4,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
		</Style>
		<Style x:Key="BuyButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource AccentPurpleBrush}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Padding" Value="20,10" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
		</Style>

	</Window.Resources>

	<StackPanel Margin="22">

		<!--  Title  -->
		<StackPanel Margin="0,0,0,2" Orientation="Horizontal">
			<Border
				Width="30"
				Height="30"
				VerticalAlignment="Center"
				Background="{StaticResource AccentPurpleSoftBrush}"
				CornerRadius="8">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="15"
					Text="🔓" />
			</Border>
			<TextBlock
				Margin="10,0,0,0"
				VerticalAlignment="Center"
				FontSize="17"
				FontWeight="Bold"
				Foreground="{StaticResource AccentPurpleBrush}"
				Text="Unlock Premium" />
		</StackPanel>
		<TextBlock
			Margin="40,3,0,14"
			FontSize="11"
			Foreground="{StaticResource TextMutedBrush}"
			Text="One-time purchase · Lifetime licence · 2 machines included" />

		<!--  Feature list  -->
		<Border Style="{StaticResource Card}">
			<StackPanel>
				<TextBlock
					Margin="0,0,0,10"
					Style="{StaticResource SectionHeader}"
					Text="WHAT YOU GET" />

				<StackPanel>
					<StackPanel.Resources>
						<Style x:Key="FeatureRow" TargetType="StackPanel">
							<Setter Property="Orientation" Value="Horizontal" />
							<Setter Property="Margin" Value="0,0,0,9" />
						</Style>
					</StackPanel.Resources>

					<StackPanel Style="{StaticResource FeatureRow}">
						<Border
							Width="16"
							Height="16"
							Margin="0,1,0,0"
							VerticalAlignment="Top"
							Background="{StaticResource AccentBlueSoftBrush}"
							CornerRadius="8">
							<Path
								Data="M 2.5 6 L 6 9.5 L 12 2.5"
								Stroke="{StaticResource AccentBlueBrush}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="1.6" />
						</Border>
						<TextBlock
							Margin="10,0,0,0"
							Text="No subscription — one-time purchase, activate on 2 machines"
							TextWrapping="Wrap" />
					</StackPanel>

					<StackPanel Style="{StaticResource FeatureRow}">
						<Border
							Width="16"
							Height="16"
							Margin="0,1,0,0"
							VerticalAlignment="Top"
							Background="{StaticResource AccentBlueSoftBrush}"
							CornerRadius="8">
							<Path
								Data="M 2.5 6 L 6 9.5 L 12 2.5"
								Stroke="{StaticResource AccentBlueBrush}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="1.6" />
						</Border>
						<TextBlock
							Margin="10,0,0,0"
							Text="Theme auto-refresh — colours update instantly on VS theme change"
							TextWrapping="Wrap" />
					</StackPanel>

					<StackPanel Style="{StaticResource FeatureRow}">
						<Border
							Width="16"
							Height="16"
							Margin="0,1,0,0"
							VerticalAlignment="Top"
							Background="{StaticResource AccentBlueSoftBrush}"
							CornerRadius="8">
							<Path
								Data="M 2.5 6 L 6 9.5 L 12 2.5"
								Stroke="{StaticResource AccentBlueBrush}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="1.6" />
						</Border>
						<TextBlock
							Margin="10,0,0,0"
							Text="Margin glyph button — toggle any comment with a single click"
							TextWrapping="Wrap" />
					</StackPanel>

					<StackPanel Style="{StaticResource FeatureRow}">
						<Border
							Width="16"
							Height="16"
							Margin="0,1,0,0"
							VerticalAlignment="Top"
							Background="{StaticResource AccentBlueSoftBrush}"
							CornerRadius="8">
							<Path
								Data="M 2.5 6 L 6 9.5 L 12 2.5"
								Stroke="{StaticResource AccentBlueBrush}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="1.6" />
						</Border>
						<TextBlock
							Margin="10,0,0,0"
							Text="Custom font family for the rendered view"
							TextWrapping="Wrap" />
					</StackPanel>

					<StackPanel Style="{StaticResource FeatureRow}">
						<Border
							Width="16"
							Height="16"
							Margin="0,1,0,0"
							VerticalAlignment="Top"
							Background="{StaticResource AccentBlueSoftBrush}"
							CornerRadius="8">
							<Path
								Data="M 2.5 6 L 6 9.5 L 12 2.5"
								Stroke="{StaticResource AccentBlueBrush}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="1.6" />
						</Border>
						<TextBlock
							Margin="10,0,0,0"
							Text="Accent bar sides — left / top / right / bottom"
							TextWrapping="Wrap" />
					</StackPanel>

					<StackPanel Margin="0" Style="{StaticResource FeatureRow}">
						<Border
							Width="16"
							Height="16"
							Margin="0,1,0,0"
							VerticalAlignment="Top"
							Background="{StaticResource AccentBlueSoftBrush}"
							CornerRadius="8">
							<Path
								Data="M 2.5 6 L 6 9.5 L 12 2.5"
								Stroke="{StaticResource AccentBlueBrush}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="1.6" />
						</Border>
						<TextBlock
							Margin="10,0,0,0"
							Text="Full colour customisation + gradient presets"
							TextWrapping="Wrap" />
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</Border>

		<!--  Buy button + warning banner  -->
		<Button
			x:Name="BuyNowButton"
			Click="OnBuyNowClicked"
			Content="Buy Premium — Open Checkout ↗"
			Style="{StaticResource BuyButton}" />

		<Border
			Margin="0,12,0,0"
			Padding="12,10"
			Background="{StaticResource WarningSoftBrush}"
			CornerRadius="8">
			<StackPanel>
				<StackPanel Margin="0,0,0,4" Orientation="Horizontal">
					<TextBlock
						VerticalAlignment="Center"
						FontSize="12"
						Foreground="{StaticResource WarningBrush}"
						Text="⚠" />
					<TextBlock
						Margin="6,0,0,0"
						VerticalAlignment="Center"
						FontSize="11"
						FontWeight="Bold"
						Foreground="{StaticResource WarningBrush}"
						Text="DO NOT CLOSE THIS WINDOW UNTIL PAYMENT IS DONE"
						TextWrapping="Wrap" />
				</StackPanel>
				<TextBlock
					Margin="23,0,0,4"
					FontSize="11"
					Foreground="#C9C9CE"
					Text="After purchase, your licence key will be pre-filled here."
					TextWrapping="Wrap" />
				<TextBlock
					Margin="23,0,0,0"
					FontSize="11"
					Foreground="#C9C9CE"
					Text="If closed, you can still activate your licence by pasting the key from your DODO Payments email. (Make sure to provide the correct email address.)"
					TextWrapping="Wrap" />
			</StackPanel>
		</Border>

		<Border Margin="0,16,0,12" Style="{StaticResource Divider}" />

		<!--  Activation form  -->
		<Border Margin="0" Style="{StaticResource Card}">
			<StackPanel>
				<TextBlock Style="{StaticResource SectionHeader}" Text="ACTIVATE YOUR LICENCE" />

				<TextBlock Style="{StaticResource HintText}" Text="If you already have a licence key, enter it here:" />

				<Grid>
					<TextBox
						x:Name="KeyBox"
						Padding="10,7,34,7"
						FontFamily="Consolas"
						ToolTip="Your licence key — paste it here or complete the checkout above" />

					<Button
						x:Name="CopyBtn"
						Width="24"
						Height="24"
						Margin="0,0,6,0"
						Padding="0"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Click="OnCopyClicked"
						Cursor="Hand"
						Template="{StaticResource GhostIconButtonTemplate}"
						ToolTip="Copy the licence key to clipboard">
						<Canvas Width="16" Height="12">
							<!--  Back square (top-right)  -->
							<Rectangle
								Canvas.Top="0"
								Width="10"
								Height="10"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Fill="Transparent"
								RadiusX="1.5"
								RadiusY="1.5"
								Stroke="{StaticResource TextMutedBrush}"
								StrokeThickness="1.5" />
							<!--  Front square (bottom-left)  -->
							<Rectangle
								Canvas.Left="3"
								Canvas.Top="3"
								Width="10"
								Height="10"
								HorizontalAlignment="Center"
								VerticalAlignment="Top"
								Fill="Transparent"
								RadiusX="1.5"
								RadiusY="1.5"
								Stroke="{StaticResource TextMutedBrush}"
								StrokeThickness="1.5" />
						</Canvas>
					</Button>
				</Grid>

				<!--  Status message  -->
				<TextBlock
					x:Name="StatusText"
					Margin="0,6,0,2"
					FontSize="11"
					TextWrapping="Wrap"
					Visibility="Collapsed" />

				<!--  Buttons  -->
				<StackPanel
					Margin="0,10,0,0"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button
						x:Name="ActivateBtn"
						Click="OnActivateClicked"
						Content="Activate"
						Style="{StaticResource PrimaryButton}" />
					<Button
						Width="70"
						Click="OnCloseClicked"
						Content="Close"
						Style="{StaticResource SecondaryButton}" />
				</StackPanel>
			</StackPanel>
		</Border>

	</StackPanel>
</Window>
