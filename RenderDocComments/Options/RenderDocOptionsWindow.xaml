<Window
	x:Class="RenderDocComments.Options.RenderDocOptionsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="RenderDocComments Options"
	Width="620"
	Height="720"
	Background="#17171A"
	FontFamily="Segoe UI"
	FontSize="13"
	Foreground="#E4E4E7"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen">

	<Window.Resources>

		<!--  ================= Palette =================  -->
		<SolidColorBrush x:Key="SurfaceBrush" Color="#212124" />
		<SolidColorBrush x:Key="SurfaceHiBrush" Color="#2A2A2E" />
		<SolidColorBrush x:Key="BorderBrush2" Color="#33333A" />
		<SolidColorBrush x:Key="TextMutedBrush" Color="#93939C" />
		<SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
		<SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#1F3B82F6" />
		<SolidColorBrush x:Key="AccentPurpleBrush" Color="#B15CF0" />
		<SolidColorBrush x:Key="DangerBrush" Color="#F48771" />

		<!--  ================= Shared button template =================  -->
		<ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
			<Border
				x:Name="border"
				Padding="{TemplateBinding Padding}"
				Background="{TemplateBinding Background}"
				BorderBrush="{TemplateBinding BorderBrush}"
				BorderThickness="{TemplateBinding BorderThickness}"
				CornerRadius="6"
				SnapsToDevicePixels="True">
				<ContentPresenter
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					RecognizesAccessKey="True" />
			</Border>
			<ControlTemplate.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter TargetName="border" Property="Opacity" Value="0.85" />
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter TargetName="border" Property="Opacity" Value="0.7" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter TargetName="border" Property="Opacity" Value="0.4" />
				</Trigger>
			</ControlTemplate.Triggers>
		</ControlTemplate>

		<!--  ================= Text styles =================  -->
		<Style x:Key="SectionHeader" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,1,0,0" />
		</Style>
		<Style x:Key="OptionLabel" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="Margin" Value="0,0,8,0" />
		</Style>
		<Style x:Key="HintText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>
		<Style x:Key="Divider" TargetType="Border">
			<Setter Property="Height" Value="1" />
			<Setter Property="Background" Value="{StaticResource BorderBrush2}" />
			<Setter Property="Margin" Value="0,14,0,14" />
		</Style>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="16" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>

		<!--  ================= CheckBox =================  -->
		<Style TargetType="CheckBox">
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,4,0,4" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal">
							<Border
								x:Name="box"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								Background="{StaticResource SurfaceHiBrush}"
								BorderBrush="{StaticResource BorderBrush2}"
								BorderThickness="1"
								CornerRadius="4">
								<Path
									x:Name="check"
									Data="M 2.5 6 L 6 9.5 L 12 2.5"
									Stroke="White"
									StrokeEndLineCap="Round"
									StrokeLineJoin="Round"
									StrokeStartLineCap="Round"
									StrokeThickness="1.6"
									Visibility="Collapsed" />
							</Border>
							<ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="box" Property="Background" Value="{StaticResource AccentBlueBrush}" />
								<Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
								<Setter TargetName="check" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= RadioButton =================  -->
		<Style TargetType="RadioButton">
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<StackPanel Orientation="Horizontal">
							<Border
								x:Name="circle"
								Width="16"
								Height="16"
								VerticalAlignment="Center"
								Background="{StaticResource SurfaceHiBrush}"
								BorderBrush="{StaticResource BorderBrush2}"
								BorderThickness="1"
								CornerRadius="8">
								<Ellipse
									x:Name="dot"
									Width="7"
									Height="7"
									Fill="White"
									Visibility="Collapsed" />
							</Border>
							<ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="circle" Property="Background" Value="{StaticResource AccentBlueBrush}" />
								<Setter TargetName="circle" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
								<Setter TargetName="dot" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="circle" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= TextBox =================  -->
		<Style TargetType="TextBox">
			<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="Margin" Value="0,2,0,2" />
			<Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6">
							<ScrollViewer
								x:Name="PART_ContentHost"
								Margin="{TemplateBinding Padding}"
								VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= ComboBox =================  -->
		<Style TargetType="ComboBox">
			<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="Margin" Value="0,2,0,2" />
			<Setter Property="ItemContainerStyle">
				<Setter.Value>
					<Style TargetType="ComboBoxItem">
						<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
						<Setter Property="Foreground" Value="#E4E4E7" />
						<Setter Property="Padding" Value="8,5" />
						<Style.Triggers>
							<Trigger Property="IsHighlighted" Value="True">
								<Setter Property="Background" Value="{StaticResource AccentBlueSoftBrush}" />
								<Setter Property="Foreground" Value="#FFFFFF" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
								<Setter Property="Foreground" Value="#FFFFFF" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<ToggleButton
								x:Name="ToggleButton"
								ClickMode="Press"
								Focusable="False"
								IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border
											Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
											BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
											BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
											CornerRadius="6">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="24" />
												</Grid.ColumnDefinitions>
												<Path
													Grid.Column="1"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Data="M 0 0 L 8 0 L 4 5 Z"
													Fill="#93939C" />
											</Grid>
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>

							<ContentPresenter
								x:Name="ContentSite"
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Content="{TemplateBinding SelectionBoxItem}"
								ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
								ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
								IsHitTestVisible="False"
								TextElement.Foreground="{TemplateBinding Foreground}" />

							<Popup
								x:Name="Popup"
								AllowsTransparency="True"
								Focusable="False"
								IsOpen="{TemplateBinding IsDropDownOpen}"
								Placement="Bottom"
								PopupAnimation="Slide">
								<Border
									MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
									MaxHeight="{TemplateBinding MaxDropDownHeight}"
									Background="{StaticResource SurfaceHiBrush}"
									BorderBrush="{StaticResource BorderBrush2}"
									BorderThickness="1"
									CornerRadius="6"
									SnapsToDevicePixels="True">
									<ScrollViewer SnapsToDevicePixels="True">
										<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.5" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= Buttons =================  -->
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="Margin" Value="4,0" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
		</Style>
		<Style x:Key="SecondaryButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource SurfaceHiBrush}" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="Margin" Value="4,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
		</Style>
		<Style x:Key="SwatchButton" TargetType="Button">
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="22" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
		</Style>

		<!--  Small inline pill marking Premium-only features  -->
		<Style x:Key="PremiumPill" TargetType="ContentControl">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="8,0,0,0" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ContentControl">
						<Border
							Padding="6,1"
							Background="{StaticResource AccentPurpleBrush}"
							CornerRadius="8">
							<TextBlock
								FontSize="8"
								FontWeight="Bold"
								Foreground="White"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Text="PREMIUM" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= Dark ToolTip Theme =================  -->
		<Style TargetType="ToolTip">
			<Setter Property="Background" Value="#1C1C20" />
			<Setter Property="Foreground" Value="#E4E4E7" />
			<Setter Property="BorderBrush" Value="#383842" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="9,6" />
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="MaxWidth" Value="290" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToolTip">
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6"
							Padding="{TemplateBinding Padding}"
							SnapsToDevicePixels="True">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="10"
									Direction="270"
									Opacity="0.45"
									ShadowDepth="3"
									Color="#000000" />
							</Border.Effect>
							<TextBlock
								FontSize="{TemplateBinding FontSize}"
								Foreground="{TemplateBinding Foreground}"
								Text="{TemplateBinding Content}"
								TextWrapping="Wrap" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  ================= InfoTip (? icon badge) =================  -->
		<Style x:Key="InfoTip" TargetType="ContentControl">
			<Setter Property="Width" Value="15" />
			<Setter Property="Height" Value="15" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="7,0,0,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="ToolTipService.InitialShowDelay" Value="0" />
			<Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
			<Setter Property="ToolTipService.ShowDuration" Value="60000" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ContentControl">
						<Border
							x:Name="badge"
							Width="15"
							Height="15"
							CornerRadius="7.5"
							SnapsToDevicePixels="True">
							<Border.Background>
								<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
									<GradientStop Color="#8B5CF6" Offset="0" />
									<GradientStop Color="#B15CF0" Offset="1" />
								</LinearGradientBrush>
							</Border.Background>
							<Canvas Width="15" Height="15">
								<Path
									x:Name="mark"
									Data="M 5.4 5.0 C 5.4 3.9 6.3 3.0 7.5 3.0 C 8.7 3.0 9.6 3.9 9.6 5.0 C 9.6 5.8 9.0 6.4 8.3 6.9 C 7.8 7.3 7.5 7.7 7.5 8.5"
									Stroke="#FFFFFF"
									StrokeThickness="1.5"
									StrokeStartLineCap="Round"
									StrokeEndLineCap="Round"
									StrokeLineJoin="Round" />
								<Ellipse
									x:Name="dot"
									Canvas.Left="6.75"
									Canvas.Top="10.2"
									Width="1.5"
									Height="1.5"
									Fill="#FFFFFF" />
							</Canvas>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="badge" Property="Opacity" Value="0.85" />
								<Setter TargetName="badge" Property="Effect">
									<Setter.Value>
										<DropShadowEffect
											BlurRadius="8"
											Color="#B15CF0"
											Opacity="0.6"
											ShadowDepth="0" />
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ── Header (always visible)  -->
		<Border
			Grid.Row="0"
			BorderBrush="{StaticResource BorderBrush2}"
			BorderThickness="0,0,0,1">
			<StackPanel
				Margin="22,16,22,16"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<TextBlock
					FontSize="17"
					FontWeight="Bold"
					Foreground="{StaticResource AccentPurpleBrush}"
					Text="Render Doc Comments" />
				<TextBlock
					Margin="10,3,0,0"
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{StaticResource TextMutedBrush}"
					Text="Visual Studio Extension" />
			</StackPanel>
		</Border>

		<!--  ── Body (scrolls)  -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
			<StackPanel Margin="20,16,20,16">

				<!--  ══ Licence  -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
							<TextBlock Style="{StaticResource SectionHeader}" Text="LICENCE" />
						</StackPanel>
						<TextBlock Style="{StaticResource HintText}" Text="Manage your extension license status and access to Premium features." />

						<StackPanel
							Margin="0,0,0,4"
							VerticalAlignment="Center"
							Orientation="Horizontal">
							<Border
								x:Name="PremiumStatusBadge"
								Margin="0,0,10,0"
								Padding="9,4"
								VerticalAlignment="Center"
								CornerRadius="6">
								<TextBlock
									x:Name="PremiumStatusText"
									FontSize="12"
									FontWeight="SemiBold" />
							</Border>

							<!--  Free: open the purchase/activation window  -->
							<Button
								x:Name="GetPremiumButton"
								Click="OnGetPremiumClicked"
								Content="Get Premium…"
								Style="{StaticResource PrimaryButton}"
								Visibility="Collapsed" />

							<!--  Premium: deactivate this machine  -->
							<Button
								x:Name="DeactivateButton"
								Click="OnDeactivateClicked"
								Content="Deactivate this machine"
								Style="{StaticResource SecondaryButton}"
								Visibility="Collapsed" />
						</StackPanel>

						<TextBlock
							x:Name="LicenseMessageText"
							Margin="0,4,0,0"
							FontSize="11"
							Foreground="{StaticResource DangerBrush}"
							TextWrapping="Wrap"
							Visibility="Collapsed" />
					</StackPanel>
				</Border>

				<!--  ══ Doc comments  -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
							<TextBlock Style="{StaticResource SectionHeader}" Text="DOC COMMENTS" />
						</StackPanel>
						<TextBlock Style="{StaticResource HintText}" Text="Transforms XML documentation comments (/// or /** */) into formatted visual cards." />

						<CheckBox
							x:Name="RenderEnabledCheck"
							Checked="OnRenderEnabledChanged"
							Content="Enable doc comment rendering"
							Unchecked="OnRenderEnabledChanged" />

						<StackPanel x:Name="ViewportWindowingSectionPanel" Margin="0,8,0,0">
							<CheckBox
								x:Name="ViewportWindowingCheck"
								Checked="OnViewportWindowingChanged"
								Content="Enable viewport pre-rendering (recommended for large files)"
								Unchecked="OnViewportWindowingChanged" />
							<StackPanel Margin="24,6,0,2" Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Style="{StaticResource OptionLabel}" Text="Pre-render lines above &amp; below (50–500):" VerticalAlignment="Center" />
								<TextBox
									x:Name="PreRenderLinesText"
									Width="60"
									VerticalAlignment="Center"
									TextAlignment="Left"
									TextChanged="OnPreRenderLinesTextChanged" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Number of off-screen lines to pre-render above and below the visible viewport (50–500). Default is 100." />
							</StackPanel>
							<TextBlock
								Margin="24,2,0,0"
								Style="{StaticResource HintText}"
								Text="Controls how many lines outside the visible screen are rendered in advance. Default is 100." />
						</StackPanel>

						<Border Style="{StaticResource Divider}" />

						<!--  Visibility mode — the margin glyph button is Premium  -->
						<StackPanel x:Name="GlyphSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="VISIBILITY MODE" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Choose how to switch between rendered documentation cards and raw XML comments. Margin glyph mode adds an interactive toggle button in the editor margin next to each comment." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Choose how to switch between rendered documentation cards and raw XML comments." />
							<StackPanel Margin="0,0,0,4">
								<RadioButton
									x:Name="CaretModeRadio"
									Margin="0,0,0,8"
									Checked="OnToggleModeChanged"
									Content="Caret-based — caret in block shows raw XML" />
								<RadioButton
									x:Name="GlyphModeRadio"
									Checked="OnToggleModeChanged"
									Content="Margin glyph button — click to toggle per comment" />
							</StackPanel>
						</StackPanel>

						<Border Style="{StaticResource Divider}" />

						<!--  Auto theme refresh  -->
						<StackPanel x:Name="AutoRefreshSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="THEME AUTO-REFRESH" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Automatically adapts rendered text and card colours to match whenever the Visual Studio colour theme changes." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Automatically update rendered comment colours when the Visual Studio colour theme changes." />
							<CheckBox
								x:Name="AutoRefreshCheck"
								Checked="OnSettingChanged"
								Content="Auto-refresh colours when VS colour theme changes"
								Unchecked="OnSettingChanged" />
						</StackPanel>

						<Border Style="{StaticResource Divider}" />

						<!--  Fixed width  -->
						<StackPanel x:Name="WidthSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="COMMENT WIDTH" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Restricts rendered doc comment cards to a specified maximum width rather than spanning the editor line." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Constrain rendered comment cards to a fixed maximum width rather than spanning the editor line." />
							<CheckBox
								x:Name="UseFixedWidthCheck"
								Checked="OnFixedWidthChanged"
								Content="Use fixed width"
								Unchecked="OnFixedWidthChanged" />
							<StackPanel Margin="24,8,0,2" Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Style="{StaticResource OptionLabel}" Text="Fixed width (px):" VerticalAlignment="Center" />
								<TextBox
									x:Name="FixedWidthText"
									Width="70"
									VerticalAlignment="Center"
									TextAlignment="Left"
									TextChanged="OnFixedWidthTextChanged" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Maximum card width in pixels (minimum 200 px). Default is 700 px." />
							</StackPanel>
							<TextBlock
								Margin="24,2,0,0"
								Style="{StaticResource HintText}"
								Text="Sets the maximum width of rendered doc comment cards in pixels. Default is 700 px." />
						</StackPanel>

						<Border Style="{StaticResource Divider}" />

						<!--  Font (applies to doc comment cards)  -->
						<StackPanel x:Name="FontSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="DOC COMMENT FONT" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Select a custom font for doc comment cards, or select '(Editor font)' to follow your Visual Studio font." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Custom typography family applied to rendered documentation comment cards." />
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Style="{StaticResource OptionLabel}" Text="Font family:" VerticalAlignment="Center" />
								<ComboBox
									x:Name="FontFamilyCombo"
									Width="200"
									VerticalAlignment="Center"
									SelectionChanged="OnFontFamilyChanged" />
								<TextBlock
									x:Name="FontPreviewText"
									Margin="12,0,0,0"
									VerticalAlignment="Center"
									Foreground="{StaticResource AccentPurpleBrush}"
									Text="AaBbCc 123" />
							</StackPanel>
						</StackPanel>

						<Border Style="{StaticResource Divider}" />

						<!--  Border sides  -->
						<StackPanel x:Name="BorderSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="ACCENT BAR SIDES" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Select which edges of the doc comment card display the decorative gradient accent bar." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Select which edges of the doc comment card display the decorative gradient accent bar." />
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<CheckBox
									x:Name="BorderLeftCheck"
									Margin="0,0,18,0"
									Checked="OnSettingChanged"
									Content="Left"
									Unchecked="OnSettingChanged" />
								<CheckBox
									x:Name="BorderTopCheck"
									Margin="0,0,18,0"
									Checked="OnSettingChanged"
									Content="Top"
									Unchecked="OnSettingChanged" />
								<CheckBox
									x:Name="BorderRightCheck"
									Margin="0,0,18,0"
									Checked="OnSettingChanged"
									Content="Right"
									Unchecked="OnSettingChanged" />
								<CheckBox
									x:Name="BorderBottomCheck"
									Checked="OnSettingChanged"
									Content="Bottom"
									Unchecked="OnSettingChanged" />
							</StackPanel>
						</StackPanel>

						<Border Style="{StaticResource Divider}" />

						<!--  Colours  -->
						<StackPanel x:Name="ColorsSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="RENDERED COLOURS" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Customize syntax colours and gradient accent bars. Click any swatch to open the colour picker." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Customize syntax colours and gradient accent bars. Click any swatch to open the colour picker." />

							<Grid Margin="0,0,0,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<StackPanel
									Grid.Row="0"
									Grid.Column="0"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchCodeFg"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="CodeFg" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Inline code / quoted" />
								</StackPanel>
								<StackPanel
									Grid.Row="0"
									Grid.Column="1"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchSummaryFg"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="SummaryFg" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Summary text" />
								</StackPanel>
								<StackPanel
									Grid.Row="1"
									Grid.Column="0"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchParamName"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="ParamName" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Parameter names" />
								</StackPanel>
								<StackPanel
									Grid.Row="1"
									Grid.Column="1"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchLink"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="Link" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Links / crefs" />
								</StackPanel>
								<StackPanel
									Grid.Row="2"
									Grid.Column="0"
									Margin="0,4"
									Orientation="Horizontal">
									<Button
										x:Name="SwatchSectionLabel"
										Click="OnSwatchClicked"
										Style="{StaticResource SwatchButton}"
										Tag="SectionLabel" />
									<TextBlock
										Margin="8,0,0,0"
										Style="{StaticResource OptionLabel}"
										Text="Section headings" />
								</StackPanel>
							</Grid>

							<!--  Gradient  -->
							<TextBlock
								Margin="0,4,0,6"
								FontSize="11"
								FontWeight="SemiBold"
								Foreground="#E4E4E7"
								Text="Gradient bar colours" />

							<WrapPanel Margin="0,0,0,8" Orientation="Horizontal">
								<TextBlock
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Style="{StaticResource OptionLabel}"
									Text="Presets:" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Purple"
									Style="{StaticResource SecondaryButton}"
									Tag="Purple" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Ocean"
									Style="{StaticResource SecondaryButton}"
									Tag="Ocean" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Sunset"
									Style="{StaticResource SecondaryButton}"
									Tag="Sunset" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Forest"
									Style="{StaticResource SecondaryButton}"
									Tag="Forest" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Rose Gold"
									Style="{StaticResource SecondaryButton}"
									Tag="RoseGold" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Cyberpunk"
									Style="{StaticResource SecondaryButton}"
									Tag="Cyberpunk" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Aurora"
									Style="{StaticResource SecondaryButton}"
									Tag="Aurora" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Solar Flare"
									Style="{StaticResource SecondaryButton}"
									Tag="SolarFlare" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Neon Glow"
									Style="{StaticResource SecondaryButton}"
									Tag="NeonGlow" />
								<Button
									Margin="3,2"
									Padding="9,4"
									Click="OnGradientPresetClicked"
									Content="Cosmic"
									Style="{StaticResource SecondaryButton}"
									Tag="Cosmic" />
							</WrapPanel>

							<StackPanel Margin="0,0,0,4" Orientation="Horizontal">
								<Button
									x:Name="SwatchGrad0"
									Width="32"
									Click="OnSwatchClicked"
									Style="{StaticResource SwatchButton}"
									Tag="Grad0" />
								<TextBlock
									Margin="4,0,14,0"
									VerticalAlignment="Center"
									FontSize="11"
									Foreground="{StaticResource TextMutedBrush}"
									Text="Stop 1" />
								<Button
									x:Name="SwatchGrad1"
									Width="32"
									Click="OnSwatchClicked"
									Style="{StaticResource SwatchButton}"
									Tag="Grad1" />
								<TextBlock
									Margin="4,0,14,0"
									VerticalAlignment="Center"
									FontSize="11"
									Foreground="{StaticResource TextMutedBrush}"
									Text="Stop 2" />
								<Button
									x:Name="SwatchGrad2"
									Width="32"
									Click="OnSwatchClicked"
									Style="{StaticResource SwatchButton}"
									Tag="Grad2" />
								<TextBlock
									Margin="4,0,14,0"
									VerticalAlignment="Center"
									FontSize="11"
									Foreground="{StaticResource TextMutedBrush}"
									Text="Stop 3" />
								<Border
									x:Name="GradientPreviewBar"
									Width="220"
									Height="22"
									Margin="10,0,0,0"
									CornerRadius="6" />
							</StackPanel>

							<Button
								Margin="0,8,0,0"
								Padding="9,4"
								HorizontalAlignment="Left"
								Click="OnResetRenderedColorsClicked"
								Content="Reset colours to defaults"
								Style="{StaticResource SecondaryButton}" />
						</StackPanel>

					</StackPanel>
				</Border>

				<!--  ══ Comment tags  -->
				<Border Style="{StaticResource Card}">
					<StackPanel>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
							<TextBlock Style="{StaticResource SectionHeader}" Text="COMMENT TAGS" />
							<ContentControl Style="{StaticResource InfoTip}" ToolTip="Highlight action tags (TODO, FIXME, NOTE, BUG, etc.) in code comments with colourful badges." />
						</StackPanel>
						<TextBlock Style="{StaticResource HintText}" Text="Highlight action tags (TODO, FIXME, NOTE, BUG, etc.) in code comments with colourful badges." />

						<CheckBox
							x:Name="TagBadgesCheck"
							Checked="OnTagBadgesChanged"
							Content="Enable comment tag highlighting"
							Unchecked="OnTagBadgesChanged" />

						<StackPanel Margin="24,8,0,2" Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock
								VerticalAlignment="Center"
								Style="{StaticResource OptionLabel}"
								Text="Comment tag style:" />
							<RadioButton
								x:Name="TagPillsRadio"
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								Checked="OnTagStyleChanged"
								Content="Pills"
								GroupName="TagStyle" />
							<RadioButton
								x:Name="TagCardsRadio"
								Margin="18,0,0,0"
								VerticalAlignment="Center"
								Checked="OnTagStyleChanged"
								Content="Card"
								GroupName="TagStyle" />
							<ContentControl Style="{StaticResource InfoTip}" ToolTip="Choose between compact rounded pill badges or full card-style badges for comment tags." />
						</StackPanel>
						<TextBlock
							Margin="24,2,0,0"
							Style="{StaticResource HintText}"
							Text="Choose between compact pill badges or full card-style badges for comment tags." />

						<Border Style="{StaticResource Divider}" />

						<!--  Scroll bar markers (Premium)  -->
						<StackPanel x:Name="ScrollMarkersSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="SCROLL BAR MARKERS" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Paints one coloured tick per comment tag (TODO, FIXME, …) in the vertical scroll bar. Click a tick to jump to the comment." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Display indicator tick marks for comment tags along the editor's vertical scroll bar." />
							<CheckBox
								x:Name="ScrollMarkersCheck"
								Checked="OnScrollMarkersChanged"
								Content="Show tag markers in the vertical scroll bar"
								Unchecked="OnScrollMarkersChanged" />
						</StackPanel>

						<Border Style="{StaticResource Divider}" />

						<!--  Tag font (Premium, applies to tag pills/cards only)  -->
						<StackPanel x:Name="TagFontSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="TAG FONT" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Select a custom font for comment tags, or select '(Editor font)' to follow your Visual Studio font." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Custom typography family applied specifically to comment tag badges and cards." />
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Style="{StaticResource OptionLabel}" Text="Font:" VerticalAlignment="Center" />
								<ComboBox
									x:Name="TagFontCombo"
									Width="200"
									VerticalAlignment="Center"
									SelectionChanged="OnTagFontChanged" />
								<TextBlock
									x:Name="TagFontPreview"
									Margin="12,0,0,0"
									VerticalAlignment="Center"
									Foreground="{StaticResource AccentPurpleBrush}"
									Text="AaBbCc 123" />
							</StackPanel>
						</StackPanel>

						<Border Style="{StaticResource Divider}" />

						<!--  Per-tag customization (Premium)  -->
						<StackPanel x:Name="TagCustomSectionPanel">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
								<TextBlock Style="{StaticResource SectionHeader}" Text="PER-TAG CUSTOMIZATION" />
								<ContentControl Style="{StaticResource PremiumPill}" />
								<ContentControl Style="{StaticResource InfoTip}" ToolTip="Per-tag visibility and colours for plain comments (TODO, FIXME, …). WARNING is an alias of WARN." />
							</StackPanel>
							<TextBlock Style="{StaticResource HintText}" Text="Per-tag visibility and colours for plain comments (TODO, FIXME, …). WARNING is an alias of WARN." />
							<StackPanel x:Name="TagBadgeListPanel" Margin="0,0,0,8" />
							<Button
								Margin="0"
								Padding="9,4"
								HorizontalAlignment="Left"
								Click="OnResetBadgeColorsClicked"
								Content="Reset colours to defaults"
								Style="{StaticResource SecondaryButton}" />
						</StackPanel>

					</StackPanel>
				</Border>

				<!--  ══ Comment boxes  -->
				<Border Style="{StaticResource Card}">
					<StackPanel x:Name="CommentBoxSectionPanel">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
							<TextBlock Style="{StaticResource SectionHeader}" Text="COMMENT BOXES" />
							<ContentControl Style="{StaticResource PremiumPill}" />
							<ContentControl Style="{StaticResource InfoTip}" ToolTip="Renders normal // comments in a thin bordered box. Default: border and text follow the IDE's comment colour; the background always follows the editor." />
						</StackPanel>
						<TextBlock Style="{StaticResource HintText}" Text="Renders normal // comments in a thin bordered box. Default: border and text follow the IDE's comment colour; the background always follows the editor. Single-line comments containing tags (TODO, FIXME, …) keep their tag pills/cards instead of a box; multi-line comments always box." />

						<CheckBox
							x:Name="CommentBoxesCheck"
							Checked="OnCommentBoxesChanged"
							Content="Enable comment box rendering"
							Unchecked="OnCommentBoxesChanged" />

						<CheckBox
							x:Name="CommentBoxThemeColorsCheck"
							Margin="0,6,0,0"
							Checked="OnCommentBoxColorsChanged"
							Content="Use theme comment colours for box border and text"
							Unchecked="OnCommentBoxColorsChanged" />

						<StackPanel Margin="24,4,0,4" Orientation="Horizontal" VerticalAlignment="Center">
							<Button
								x:Name="SwatchCommentBoxBorder"
								Click="OnSwatchClicked"
								Style="{StaticResource SwatchButton}"
								Tag="CommentBoxBorder" />
							<TextBlock
								Margin="8,0,18,0"
								VerticalAlignment="Center"
								Style="{StaticResource OptionLabel}"
								Text="Box border" />
							<Button
								x:Name="SwatchCommentBoxText"
								Click="OnSwatchClicked"
								Style="{StaticResource SwatchButton}"
								Tag="CommentBoxText" />
							<TextBlock
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								Style="{StaticResource OptionLabel}"
								Text="Box text" />
						</StackPanel>

						<StackPanel Margin="0,4,0,0" Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Style="{StaticResource OptionLabel}" Text="Font:" VerticalAlignment="Center" />
							<ComboBox
								x:Name="CommentBoxFontCombo"
								Width="200"
								VerticalAlignment="Center"
								SelectionChanged="OnCommentBoxFontChanged" />
							<TextBlock
								x:Name="CommentBoxFontPreview"
								Margin="12,0,0,0"
								VerticalAlignment="Center"
								Foreground="{StaticResource AccentPurpleBrush}"
								Text="AaBbCc 123" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!--  ══ Banner comments  -->
				<Border Style="{StaticResource Card}">
					<StackPanel x:Name="BannerSectionPanel">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
							<TextBlock Style="{StaticResource SectionHeader}" Text="BANNER COMMENTS" />
							<ContentControl Style="{StaticResource PremiumPill}" />
							<ContentControl Style="{StaticResource InfoTip}" ToolTip="Collapses banner-style comments — solid rules, flanked headings, ruled blocks, and ASCII boxes — into a slim section title with a fading rule." />
						</StackPanel>
						<TextBlock Style="{StaticResource HintText}" Text="Collapses banner-style comments — solid rules (// ─────), flanked headings (// ── Title ────), ruled blocks (rule / text / rule), and ASCII boxes (┌─┐, +--+) — into a slim section title with a fading rule. Works even when comment box rendering is switched off (non-banner comments then stay as plain text)." />

						<CheckBox
							x:Name="BannerCommentsCheck"
							Checked="OnBannerCommentsChanged"
							Content="Render banner comments as section headers"
							Unchecked="OnBannerCommentsChanged" />

						<CheckBox
							x:Name="RegionBannersCheck"
							Margin="0,6,0,0"
							Checked="OnRegionBannersChanged"
							Content="Show #region directives as banners"
							Unchecked="OnRegionBannersChanged" />
						<TextBlock
							Margin="24,2,0,0"
							Style="{StaticResource HintText}"
							Text="Renders #region lines as collapsible full-width banner bars in C#, VB.NET, and C++." />

						<StackPanel x:Name="BannerStylePanel" Margin="0,6,0,0">
							<CheckBox
								x:Name="BannerThemeColorsCheck"
								Checked="OnBannerColorsChanged"
								Content="Use theme comment colours for banner text and rule"
								Unchecked="OnBannerColorsChanged" />

							<StackPanel Margin="24,4,0,4" Orientation="Horizontal" VerticalAlignment="Center">
								<Button
									x:Name="SwatchBannerText"
									Click="OnSwatchClicked"
									Style="{StaticResource SwatchButton}"
									Tag="BannerText" />
								<TextBlock
									Margin="8,0,18,0"
									VerticalAlignment="Center"
									Style="{StaticResource OptionLabel}"
									Text="Banner text" />
								<Button
									x:Name="SwatchBannerRule"
									Click="OnSwatchClicked"
									Style="{StaticResource SwatchButton}"
									Tag="BannerRule" />
								<TextBlock
									Margin="8,0,0,0"
									VerticalAlignment="Center"
									Style="{StaticResource OptionLabel}"
									Text="Rule / fence / wave / box" />
							</StackPanel>

							<DockPanel Margin="0,4,0,0" LastChildFill="False">
								<StackPanel
									DockPanel.Dock="Left"
									Orientation="Horizontal"
									VerticalAlignment="Center">
									<TextBlock Style="{StaticResource OptionLabel}" Text="Rule thickness:" VerticalAlignment="Center" />
									<TextBox
										x:Name="BannerRuleThicknessText"
										Width="60"
										VerticalAlignment="Center"
										TextChanged="OnBannerRuleThicknessChanged" />
									<ContentControl Style="{StaticResource InfoTip}" ToolTip="Hairline rule thickness in pixels (1–8). Default is 1." />
								</StackPanel>
								<StackPanel
									DockPanel.Dock="Right"
									Orientation="Horizontal"
									VerticalAlignment="Center">
									<TextBlock
										Margin="0,0,6,0"
										Style="{StaticResource OptionLabel}"
										VerticalAlignment="Center"
										Text="Bar height (0 = auto):" />
									<TextBox
										x:Name="BannerBarHeightText"
										Width="60"
										VerticalAlignment="Center"
										TextChanged="OnBannerBarHeightChanged" />
									<ContentControl Style="{StaticResource InfoTip}" ToolTip="Fixed bar height in pixels (10–80). 0 = size the bar to its text." />
								</StackPanel>
							</DockPanel>

							<DockPanel Margin="0,6,0,0" LastChildFill="False">
								<StackPanel
									DockPanel.Dock="Left"
									Orientation="Horizontal"
									VerticalAlignment="Center">
									<TextBlock Style="{StaticResource OptionLabel}" Text="Font:" VerticalAlignment="Center" />
									<ComboBox
										x:Name="BannerFontCombo"
										Width="170"
										VerticalAlignment="Center"
										SelectionChanged="OnBannerFontChanged" />
									<TextBlock
										x:Name="BannerFontPreview"
										Margin="10,0,0,0"
										VerticalAlignment="Center"
										Foreground="{StaticResource AccentPurpleBrush}"
										Text="AaBbCc 123" />
								</StackPanel>
								<StackPanel
									DockPanel.Dock="Right"
									Orientation="Horizontal"
									VerticalAlignment="Center">
									<TextBlock
										Margin="0,0,6,0"
										VerticalAlignment="Center"
										Style="{StaticResource OptionLabel}"
										Text="Size:" />
									<TextBox
										x:Name="BannerFontSizeText"
										Width="60"
										VerticalAlignment="Center"
										TextChanged="OnBannerFontSizeChanged" />
									<ContentControl Style="{StaticResource InfoTip}" ToolTip="Banner font and size in pixels. 0 = follow the editor font size. Leave font on '(Box / editor font)' to match." />
								</StackPanel>
							</DockPanel>
						</StackPanel>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!--  ── Footer (always visible)  -->
		<Border
			Grid.Row="2"
			Padding="20,12"
			Background="#1D1D20"
			BorderBrush="{StaticResource BorderBrush2}"
			BorderThickness="0,1,0,0">
			<Grid>
				<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
					<Button
						Click="RatingButton_Click"
						Content="Please, leave a review"
						Foreground="{StaticResource AccentPurpleBrush}"
						Style="{StaticResource SecondaryButton}" />
				</StackPanel>
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						Click="OnResetClicked"
						Content="Reset to Defaults"
						Style="{StaticResource SecondaryButton}" />
					<Button
						Click="OnSaveClicked"
						Content="Save"
						Style="{StaticResource PrimaryButton}" />
					<Button
						Click="OnCloseClicked"
						Content="Close"
						Style="{StaticResource SecondaryButton}" />
				</StackPanel>
			</Grid>
		</Border>

	</Grid>
</Window>
