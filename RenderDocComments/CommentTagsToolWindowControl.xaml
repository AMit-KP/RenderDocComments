<UserControl
	x:Class="RenderDocComments.CommentTagsToolWindowControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:RenderDocComments"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
	d:DesignHeight="500"
	d:DesignWidth="320"
	Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
	FontFamily="Segoe UI"
	Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
	mc:Ignorable="d">

	<UserControl.Resources>

		<!--  ================= Shared brushes / metrics =================  -->
		<SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
		<SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3B82F6" />
		<SolidColorBrush x:Key="HoverBrush" Color="#14808080" />
		<SolidColorBrush x:Key="PressedBrush" Color="#22808080" />
		<SolidColorBrush x:Key="SeparatorBrush" Color="#22808080" />
		<SolidColorBrush x:Key="CardBrush" Color="#0C808080" />

		<!--  Flat, ghost-style icon/text button  -->
		<Style x:Key="GhostButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="10,5" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							x:Name="border"
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							CornerRadius="6"
							SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  Segmented control tab  -->
		<Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
			<Setter Property="Opacity" Value="0.65" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border
							x:Name="border"
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							CornerRadius="6"
							SnapsToDevicePixels="True">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}" />
								<Setter Property="Opacity" Value="1" />
								<Setter Property="Foreground" Value="White" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  Small pill badge (counts)  -->
		<Style x:Key="CountBadgeStyle" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource CardBrush}" />
			<Setter Property="CornerRadius" Value="9" />
			<Setter Property="Padding" Value="7,2" />
			<Setter Property="Margin" Value="6,0,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="CountBadgeTextStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="10" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
			<Setter Property="Opacity" Value="0.7" />
		</Style>

		<!--  Colored tag chip  -->
		<Style x:Key="TagChipStyle" TargetType="Border">
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  TreeViewItem: flat rows, no default selection chrome, gentle hover  -->
		<Style TargetType="TreeViewItem">
			<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
			<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
			<Setter Property="Padding" Value="4,3" />
			<Setter Property="Margin" Value="0,1" />
			<Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TreeViewItem">
						<StackPanel>
							<Border
								x:Name="RowBorder"
								Padding="{TemplateBinding Padding}"
								Background="Transparent"
								CornerRadius="6">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<ToggleButton
										x:Name="Expander"
										Grid.Column="0"
										Width="14"
										Margin="0,0,2,0"
										VerticalAlignment="Center"
										ClickMode="Press"
										IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
										<ToggleButton.Template>
											<ControlTemplate TargetType="ToggleButton">
												<Grid Background="Transparent">
													<Path
														x:Name="Arrow"
														VerticalAlignment="Center"
														Data="M 0 0 L 4 4 L 0 8 Z"
														Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
														Opacity="0.6" />
												</Grid>
												<ControlTemplate.Triggers>
													<Trigger Property="IsChecked" Value="True">
														<Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 4 Z" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</ToggleButton.Template>
									</ToggleButton>
									<ContentPresenter
										x:Name="PART_Header"
										Grid.Column="1"
										VerticalAlignment="Center"
										ContentSource="Header" />
								</Grid>
							</Border>
							<ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsExpanded" Value="False">
								<Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
							</Trigger>
							<Trigger Property="HasItems" Value="False">
								<Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="RowBorder" Property="Background" Value="{StaticResource HoverBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="RowBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</UserControl.Resources>

	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Row 0: Header  -->
		<Grid Grid.Row="0" Margin="2,0,2,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" VerticalAlignment="Center">
				<TextBlock
					FontSize="14"
					FontWeight="SemiBold"
					Text="Comment Tags" />
				<TextBlock
					Margin="0,2,0,0"
					FontSize="11"
					Opacity="0.6"
					Text="{Binding StatusMessage}"
					TextTrimming="CharacterEllipsis" />
			</StackPanel>

			<Button
				Grid.Column="1"
				Padding="8,6"
				Click="OnRefreshClicked"
				Style="{StaticResource GhostButtonStyle}"
				ToolTip="Rescan solution files for comment tags">
				<StackPanel Orientation="Horizontal">
					<Path
						Width="9"
						Height="9"
						VerticalAlignment="Center"
						Data="M 8 1 A 7 7 0 1 0 15 8"
						Stretch="Uniform"
						Stroke="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
						StrokeThickness="1.4" />
					<Path
						Width="5"
						Height="5"
						Margin="-4,0,0,0"
						VerticalAlignment="Center"
						Data="M 15 8 L 15 3 L 10 3 Z"
						Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
						Stretch="Uniform" />
					<TextBlock
						Margin="6,0,0,0"
						VerticalAlignment="Center"
						Text="Refresh" />
				</StackPanel>
			</Button>
		</Grid>

		<!--  Row 1: Segmented control  -->
		<Border
			Grid.Row="1"
			Margin="0,0,0,10"
			Padding="3"
			Background="{StaticResource CardBrush}"
			CornerRadius="8">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<RadioButton
					x:Name="TagsTabRadio"
					Grid.Column="0"
					Click="OnTabRadioClicked"
					Content="Tags"
					GroupName="ViewModeGroup"
					IsChecked="True"
					Style="{StaticResource TabRadioButtonStyle}" />

				<RadioButton
					x:Name="FilesTabRadio"
					Grid.Column="1"
					Click="OnTabRadioClicked"
					Content="Files"
					GroupName="ViewModeGroup"
					Style="{StaticResource TabRadioButtonStyle}" />
			</Grid>
		</Border>

		<!--  Row 2: TreeViews Container  -->
		<Grid Grid.Row="2">
			<!--  1. Tags TreeView (Grouped by Tag -> File -> Occurrences)  -->
			<TreeView
				x:Name="TagsTreeView"
				Background="Transparent"
				BorderThickness="0"
				ItemsSource="{Binding Tags}"
				KeyDown="OnTreeViewKeyDown"
				MouseDoubleClick="OnTreeViewDoubleClick"
				Visibility="Visible">
				<TreeView.Resources>

					<!--  Root Tag Template  -->
					<HierarchicalDataTemplate DataType="{x:Type local:TagNodeViewModel}" ItemsSource="{Binding Files}">
						<Grid Margin="0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Border
								Grid.Column="0"
								Background="{Binding TagColorBrush}"
								Style="{StaticResource TagChipStyle}">
								<TextBlock
									FontSize="11"
									FontWeight="Bold"
									Foreground="{Binding TagForegroundBrush}"
									Text="{Binding TagName}" />
							</Border>

							<Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
								<TextBlock Style="{StaticResource CountBadgeTextStyle}" Text="{Binding Count}" />
							</Border>
						</Grid>
					</HierarchicalDataTemplate>

					<!--  File Template (under Tag)  -->
					<HierarchicalDataTemplate DataType="{x:Type local:FileNodeViewModel}" ItemsSource="{Binding Comments}">
						<Grid Margin="0,3" ToolTip="{Binding FilePath}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Border
								Grid.Column="0"
								Width="18"
								Height="18"
								Margin="0,0,6,0"
								Background="{StaticResource CardBrush}"
								CornerRadius="4">
								<Path
									Width="9"
									Height="9"
									Data="M 3 0 L 9 0 L 12 3 L 12 14 L 3 14 Z"
									Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
									Opacity="0.55"
									Stretch="Uniform" />
							</Border>

							<TextBlock
								Grid.Column="1"
								VerticalAlignment="Center"
								FontSize="12"
								FontWeight="Medium"
								Text="{Binding FileName}"
								TextTrimming="CharacterEllipsis" />

							<Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
								<TextBlock Style="{StaticResource CountBadgeTextStyle}" Text="{Binding Count}" />
							</Border>
						</Grid>
					</HierarchicalDataTemplate>

					<!--  Comment Item Leaf Template  -->
					<DataTemplate DataType="{x:Type local:CommentItemNodeViewModel}">
						<Grid Margin="0,2" Cursor="Hand">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Border
								Grid.Column="0"
								Margin="0,0,6,0"
								Padding="5,1"
								VerticalAlignment="Center"
								Background="{StaticResource CardBrush}"
								CornerRadius="4">
								<TextBlock
									FontSize="10"
									FontWeight="SemiBold"
									Opacity="0.7"
									Text="{Binding LineNumber, StringFormat='Ln {0}'}" />
							</Border>

							<TextBlock
								Grid.Column="1"
								VerticalAlignment="Center"
								FontSize="11"
								Opacity="0.9"
								Text="{Binding CleanCommentText}"
								TextTrimming="CharacterEllipsis"
								ToolTip="{Binding CleanCommentText}" />
						</Grid>
					</DataTemplate>
				</TreeView.Resources>
			</TreeView>

			<!--  2. Files TreeView (Grouped by File -> Tag Occurrences by Line Number)  -->
			<TreeView
				x:Name="FilesTreeView"
				Background="Transparent"
				BorderThickness="0"
				ItemsSource="{Binding Files}"
				KeyDown="OnTreeViewKeyDown"
				MouseDoubleClick="OnTreeViewDoubleClick"
				Visibility="Collapsed">
				<TreeView.Resources>

					<!--  Root File Template  -->
					<HierarchicalDataTemplate DataType="{x:Type local:FileNodeViewModel}" ItemsSource="{Binding Comments}">
						<Grid Margin="0,3" ToolTip="{Binding FilePath}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Border
								Grid.Column="0"
								Width="18"
								Height="18"
								Margin="0,0,6,0"
								Background="{StaticResource CardBrush}"
								CornerRadius="4">
								<Path
									Width="9"
									Height="9"
									Data="M 3 0 L 9 0 L 12 3 L 12 14 L 3 14 Z"
									Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
									Opacity="0.55"
									Stretch="Uniform" />
							</Border>

							<TextBlock
								Grid.Column="1"
								VerticalAlignment="Center"
								FontSize="12"
								FontWeight="Medium"
								Text="{Binding FileName}"
								TextTrimming="CharacterEllipsis" />

							<Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
								<TextBlock Style="{StaticResource CountBadgeTextStyle}" Text="{Binding Count}" />
							</Border>
						</Grid>
					</HierarchicalDataTemplate>

					<!--  Comment Item Leaf Template (tag chip + line + text)  -->
					<DataTemplate DataType="{x:Type local:CommentItemNodeViewModel}">
						<Grid Margin="0,2" Cursor="Hand">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Border
								Grid.Column="0"
								Margin="0,0,6,0"
								Background="{Binding TagColorBrush}"
								Style="{StaticResource TagChipStyle}">
								<TextBlock
									FontSize="10"
									FontWeight="Bold"
									Foreground="{Binding TagForegroundBrush}"
									Text="{Binding TagName}" />
							</Border>

							<Border
								Grid.Column="1"
								Margin="0,0,6,0"
								Padding="5,1"
								VerticalAlignment="Center"
								Background="{StaticResource CardBrush}"
								CornerRadius="4">
								<TextBlock
									FontSize="10"
									FontWeight="SemiBold"
									Opacity="0.7"
									Text="{Binding LineNumber, StringFormat='Ln {0}'}" />
							</Border>

							<TextBlock
								Grid.Column="2"
								VerticalAlignment="Center"
								FontSize="11"
								Opacity="0.9"
								Text="{Binding CleanCommentText}"
								TextTrimming="CharacterEllipsis"
								ToolTip="{Binding CleanCommentText}" />
						</Grid>
					</DataTemplate>
				</TreeView.Resources>
			</TreeView>
		</Grid>

		<!--  Row 3: Bottom Action Bar  -->
		<Border
			Grid.Row="3"
			Margin="0,10,0,0"
			Padding="0,10,0,0"
			BorderBrush="{StaticResource SeparatorBrush}"
			BorderThickness="0,1,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Button
					Grid.Column="0"
					Margin="0,0,4,0"
					Click="OnExpandAllClicked"
					Content="Expand All"
					Style="{StaticResource GhostButtonStyle}" />

				<Button
					Grid.Column="1"
					Click="OnCollapseAllClicked"
					Content="Collapse All"
					Style="{StaticResource GhostButtonStyle}" />

				<Border
					Grid.Column="3"
					Padding="8,3"
					Background="{StaticResource AccentSoftBrush}"
					CornerRadius="9">
					<TextBlock
						FontSize="11"
						FontWeight="SemiBold"
						Foreground="{StaticResource AccentBrush}"
						Text="{Binding TotalCount, StringFormat='Total: {0}'}" />
				</Border>
			</Grid>
		</Border>
	</Grid>
</UserControl>
