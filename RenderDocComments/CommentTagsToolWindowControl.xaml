<UserControl x:Class="RenderDocComments.CommentTagsToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:RenderDocComments"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="320"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">

    <UserControl.Resources>
        <!-- Simple modern scrollbar and button styles using VS Shell brushes -->
        <Style TargetType="Button" x:Key="ModernButtonStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientBeginKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarSelectedKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Count Badge Style -->
        <Style TargetType="Border" x:Key="CountBadgeStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="6,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="CountBadgeTextStyle">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- TreeViewItem styling -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header / Quick Actions -->
        <Grid Grid.Row="0" Margin="6,6,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusMessage}" 
                       FontSize="11" 
                       VerticalAlignment="Center" 
                       Opacity="0.75" 
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

            <Button Grid.Column="1" 
                    Content="↻ Refresh" 
                    Click="OnRefreshClicked"
                    Style="{StaticResource ModernButtonStyle}" 
                    Padding="6,2"
                    ToolTip="Rescan solution files for comment tags"/>
        </Grid>

        <!-- Main Comment Tags TreeView -->
        <TreeView Grid.Row="1" 
                  x:Name="TagsTreeView"
                  ItemsSource="{Binding Tags}"
                  Background="Transparent"
                  BorderThickness="0"
                  Margin="2"
                  MouseDoubleClick="OnTreeViewDoubleClick"
                  KeyDown="OnTreeViewKeyDown">
            <TreeView.Resources>
                <!-- Root Tag Template -->
                <HierarchicalDataTemplate DataType="{x:Type local:TagNodeViewModel}" ItemsSource="{Binding Files}">
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tag Badge Pill -->
                        <Border Grid.Column="0" 
                                Background="{Binding TagColorBrush}" 
                                CornerRadius="4" 
                                Padding="5,1,5,1" 
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TagName}" 
                                       Foreground="{Binding TagForegroundBrush}" 
                                       FontWeight="Bold" 
                                       FontSize="11"/>
                        </Border>

                        <!-- Tag Count -->
                        <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
                            <TextBlock Text="{Binding Count}" Style="{StaticResource CountBadgeTextStyle}"/>
                        </Border>
                    </Grid>
                </HierarchicalDataTemplate>

                <!-- File Template -->
                <HierarchicalDataTemplate DataType="{x:Type local:FileNodeViewModel}" ItemsSource="{Binding Comments}">
                    <Grid Margin="0,2" ToolTip="{Binding FilePath}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="📄 " 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding FileName}" 
                                   FontSize="12" 
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- File Occurrence Count -->
                        <Border Grid.Column="2" Style="{StaticResource CountBadgeStyle}">
                            <TextBlock Text="{Binding Count}" Style="{StaticResource CountBadgeTextStyle}"/>
                        </Border>
                    </Grid>
                </HierarchicalDataTemplate>

                <!-- Comment Item Leaf Template -->
                <DataTemplate DataType="{x:Type local:CommentItemNodeViewModel}">
                    <Grid Margin="0,1" Cursor="Hand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="{Binding LineNumber, StringFormat='Line {0}: '}" 
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Opacity="0.75"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding CleanCommentText}" 
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CleanCommentText}"/>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" 
                BorderThickness="0,1,0,0" 
                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarBorderKey}}" 
                Padding="6,6"
                Background="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarGradientBeginKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="Expand All" 
                        Click="OnExpandAllClicked"
                        Style="{StaticResource ModernButtonStyle}" 
                        Margin="0,0,4,0"/>

                <Button Grid.Column="1" 
                        Content="Collapse All" 
                        Click="OnCollapseAllClicked"
                        Style="{StaticResource ModernButtonStyle}"/>

                <TextBlock Grid.Column="3" 
                           Text="{Binding TotalCount, StringFormat='Total: {0}'}" 
                           VerticalAlignment="Center" 
                           FontSize="11" 
                           FontWeight="SemiBold"
                           Opacity="0.85"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

